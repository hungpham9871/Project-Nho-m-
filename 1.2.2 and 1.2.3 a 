        "        bin_count (int): The number of bins for the histogram.\n",
        "        title_suffix (str): An optional suffix for the plot title.\n",
        "    \"\"\"\n",
        "    # Create a copy to avoid modifying the original DataFrame directly for plotting purposes\n",
        "    temp_df = data.copy()\n",
        "\n",
        "    # Columns where 0 typically represents a missing value in the Pima Indians Diabetes dataset\n",
        "    zero_as_nan_cols = ['Glucose', 'BloodPressure', 'SkinThickness', 'Insulin', 'BMI']\n",
        "\n",
        "    if column in zero_as_nan_cols:\n",
        "        temp_df[column] = temp_df[column].replace(0, np.nan)\n",
        "\n",
        "    plt.figure(figsize=(10, 6))\n",
        "    sns.histplot(data=temp_df, x=column, hue='Outcome', kde=True, bins=bin_count, palette='viridis')\n",
        "    plt.title(f'Distribution of {column} by Outcome {title_suffix}')\n",
        "    plt.xlabel(column)\n",
        "    plt.ylabel('Count')\n",
        "    plt.show()\n",
